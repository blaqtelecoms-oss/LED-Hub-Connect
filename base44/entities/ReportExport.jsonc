{
  "name": "ReportExport",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "IDP progress report",
        "Council summary",
        "COGTA return",
        "Ward coverage report"
      ]
    },
    "generated_by": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "file": {
      "type": "string"
    },
    "is_demo_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}