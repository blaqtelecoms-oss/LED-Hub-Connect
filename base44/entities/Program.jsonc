{
  "name": "Program",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "funder": {
      "type": "string",
      "enum": [
        "Municipality",
        "SEDA",
        "SEFA",
        "COGTA",
        "Other"
      ]
    },
    "max_amount": {
      "type": "number"
    },
    "support_type": {
      "type": "string"
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "CIPC registration",
          "B-BBEE affidavit",
          "Photos",
          "Bank confirmation letter",
          "Tax clearance certificate"
        ]
      }
    },
    "slots_total": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "is_demo_data": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "name",
    "funder",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}